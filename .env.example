# RSVP storage. Leave unset and the form tells guests storage is not configured.
# "file"    -> appends to ./data/rsvps.jsonl (local or single-server hosting only)
# "webhook" -> POSTs each RSVP as JSON to RSVP_WEBHOOK_URL (Sheets script, Zapier, your API)
RSVP_STORAGE=
RSVP_WEBHOOK_URL=
# Public address, used for share links and the social preview
SITE_URL=http://localhost:3000
